{
  "name": "quali-nirs4all",
  "private": true,
  "version": "0.0.6",
  "type": "module",
  "description": "quali-nirs4all — a guided WASM studio for NIRS analysis labs (sample triage, HPLC selection, calibration, prediction reliability). Thin shell over the nirs4all WASM stack; reuses nirs4all-web's staged engine and nirs4all-ui.",
  "license": "(CECILL-2.1 OR AGPL-3.0-or-later)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode singlefile",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/wasm-smoke.mjs",
    "test:model-import": "node scripts/model-import-contract.mjs",
    "test:server-workspace": "node scripts/server-workspace-contract.mjs",
    "deploy": "bash scripts/deploy-pages.sh",
    "test:science": "npm run test:science:native && npm run test:calibration",
    "test:methods-cohort": "node --test scripts/methods-cohort-contract.mjs",
    "test:assessment": "node scripts/shared-assessment-contract.mjs",
    "test:assessment-browser": "node scripts/assessment-browser.mjs",
    "test:science:native": "node scripts/science-contract.mjs",
    "test:calibration": "node --test scripts/scientific-contract.test.mjs"
  },
  "dependencies": {
    "@nirs4all/server-client": "file:vendor/npm/nirs4all-server-client-0.1.0-local.20261113.2.tgz",
    "lucide-react": "0.487.0",
    "nirs4all": "file:vendor/owners-current/core",
    "nirs4all-ui": "file:vendor/npm/nirs4all-ui-0.2.2-local.20261107.2.tgz",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.25.12",
    "playwright-core": "1.49.1",
    "png-to-ico": "^2.1.8",
    "tailwindcss": "4.1.12",
    "typescript": "5.6.3",
    "vite": "6.4.5",
    "vite-plugin-singlefile": "2.1.0"
  },
  "peerDependencies": {
    "@nirs4all/methods": ">=1.3.15 <2"
  },
  "peerDependenciesMeta": {
    "@nirs4all/methods": {
      "optional": true
    }
  }
}
